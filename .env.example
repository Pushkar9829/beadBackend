PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kuberstones
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173

# Amazon S3 (set AWS_S3_BUCKET or AWS_S3_BUCKET_NAME to enable)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# CloudFront origin, no trailing slash (used as the public image URL)
CLOUDFRONT_DOMAIN=
# Optional. Most new buckets block ACLs — leave empty and use a public-read bucket policy instead.
# S3_ACL=public-read
