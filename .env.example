# ---- Core ----
NODE_ENV=development          # MUST be "production" in production (secure cookies, strict CORS, hidden error details)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kuberstones
# Random string, at least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=7d
# Comma-separated extra browser origins allowed by CORS (the Vercel URL is built in)
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for payment return/webhook URLs)
API_PUBLIC_URL=
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_PER_MIN=300
HTTP_TIMEOUT_MS=15000

# ---- Bootstrap admin (created on first start only if both are set; password >= 12 chars) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo customer account, never created in production
SEED_DEMO_USER=false
DEMO_EMAIL=
DEMO_PASSWORD=
# npm run seed wipes the DB. Against a non-local DB it also needs: npm run seed -- --force
SEED_ALLOW_DESTRUCTIVE=

# ---- Pending order expiry (minutes) ----
PENDING_ORDER_TTL_MINUTES=60          # gateway (Cashfree) orders
PENDING_UPI_ORDER_TTL_MINUTES=1440

# ---- Cashfree (can also be set in Admin > Settings) ----
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---- iThink Logistics (can also be set in Admin > Settings) ----
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
ITHINK_ENV=staging
ITHINK_PICKUP_ADDRESS_ID=
ITHINK_RETURN_ADDRESS_ID=
ITHINK_LOGISTICS=
# Required: webhook calls are rejected when no secret is set. Sent as the x-ithink-token header.
ITHINK_WEBHOOK_SECRET=
# Header token for POST /api/shipping/ithink/sync (cron). Falls back to ITHINK_WEBHOOK_SECRET.
ITHINK_SYNC_SECRET=

# ---- AstrologyAPI (free Kundli; astrologyapi.com). Set on Render only, never commit real values ----
# ASTROLOGY_API_KEY = the wallet access token (Dashboard -> Credentials), sent as the x-astrologyapi-key header.
# ASTROLOGY_API_USER_ID only for a legacy subscription key pair (adds HTTP Basic auth); leave it empty otherwise.
# A full Kundli spends 8 calls; Admin -> Sales -> Kundli -> Settings can switch parts off and set run limits.
ASTROLOGY_API_USER_ID=
ASTROLOGY_API_KEY=
# 1 = canned mock responses, no calls or credits (local/tests only; never set it on Render). Without a key
# and without this flag, generation fails with "AstrologyAPI is not configured".
ASTROLOGY_API_MOCK=
# Optional (overrides the admin setting). Only orders paid (online/UPI) or delivered (COD) on/after this date unlock the free Kundli.
# YYYY-MM-DD = midnight IST, or a full ISO date-time. Unset: the date this version first started (stored in
# the kundlisettings collection, so it never moves on a restart).
KUNDLI_ELIGIBLE_FROM=
# Optional fallbacks (the admin Kundli settings win when set). New (uncached) place-search lookups allowed per IST day across all instances (default 500).
KUNDLI_PLACES_DAILY_CAP=
# Optional. Customer limits: regenerations of a generated Kundli (default 3), retries of a failed one (default 3).
KUNDLI_CUSTOMER_REGEN_CAP=
KUNDLI_CUSTOMER_RETRY_CAP=
# Optional. Timeouts in ms: JSON endpoints (default 20000) and the PDF (default 60000).
ASTROLOGY_API_TIMEOUT_MS=
ASTROLOGY_API_PDF_TIMEOUT_MS=

# ---- WhatsApp login codes (Meta WhatsApp Cloud API). Set on the server only, never commit real values ----
# Permanent system-user token + the business number's phone number ID; template = the approved Authentication
# template (copy-code button). OTP_TTL_MIN must match the expiry shown in that template (default 2).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_OTP_TEMPLATE=otp_login
WHATSAPP_OTP_LANG=en
WHATSAPP_OTP_TTL_MIN=2
# Webhook (delivery receipts): https://<api>/api/whatsapp/webhook ; verify token = any long random word, the
# app secret checks Meta's X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# 1 = no Meta calls, the code is returned to the browser (local tests only; ignored when NODE_ENV=production).
WHATSAPP_MOCK=

# ---- Amazon S3 (set AWS_S3_BUCKET or AWS_S3_BUCKET_NAME to enable) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# CloudFront origin, no trailing slash (used as the public image URL)
CLOUDFRONT_DOMAIN=
# Optional. Most new buckets block ACLs — leave empty and use a public-read bucket policy instead.
# S3_ACL=public-read
