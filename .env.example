# ---- Core ----
NODE_ENV=development          # MUST be "production" in production (secure cookies, strict CORS, hidden error details)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kuberstones
# Random string, at least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=7d
# Comma-separated extra browser origins allowed by CORS (the Vercel URL is built in)
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for payment return/webhook URLs)
API_PUBLIC_URL=
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_PER_MIN=300
HTTP_TIMEOUT_MS=15000

# ---- Bootstrap admin (created on first start only if both are set; password >= 12 chars) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo customer account, never created in production
SEED_DEMO_USER=false
DEMO_EMAIL=
DEMO_PASSWORD=
# npm run seed wipes the DB. Against a non-local DB it also needs: npm run seed -- --force
SEED_ALLOW_DESTRUCTIVE=

# ---- Pending order expiry (minutes) ----
PENDING_ORDER_TTL_MINUTES=60          # gateway (Cashfree) orders
PENDING_UPI_ORDER_TTL_MINUTES=1440

# ---- Cashfree (can also be set in Admin > Settings) ----
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---- iThink Logistics (can also be set in Admin > Settings) ----
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
ITHINK_ENV=staging
ITHINK_PICKUP_ADDRESS_ID=
ITHINK_RETURN_ADDRESS_ID=
ITHINK_LOGISTICS=
# Required: webhook calls are rejected when no secret is set. Sent as the x-ithink-token header.
ITHINK_WEBHOOK_SECRET=
# Header token for POST /api/shipping/ithink/sync (cron). Falls back to ITHINK_WEBHOOK_SECRET.
ITHINK_SYNC_SECRET=

# ---- Amazon S3 (set AWS_S3_BUCKET or AWS_S3_BUCKET_NAME to enable) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# CloudFront origin, no trailing slash (used as the public image URL)
CLOUDFRONT_DOMAIN=
# Optional. Most new buckets block ACLs — leave empty and use a public-read bucket policy instead.
# S3_ACL=public-read
